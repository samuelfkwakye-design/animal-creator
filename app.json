{
  "expo": {
    "name": "Animal Creator",
    "slug": "animal-creator",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "animalcreator",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Animal Creator to turn Jason's speech into text.",
        "NSMicrophoneUsageDescription": "Allow Animal Creator to hear Jason say an animal name."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080b18"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.animalcreator"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-media-library",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Animal Creator to hear Jason say an animal name.",
          "speechRecognitionPermission": "Allow Animal Creator to turn Jason's speech into text."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "579d82f5-d0b1-4ebe-b782-e19986721d47"
      }
    }
  }
}
